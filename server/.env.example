PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smart_kitchen
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
ML_SERVICE_URL=http://127.0.0.1:8000
# Days before expiry at which a batch raises an "expiring" alert
EXPIRY_WARN_DAYS=3
# Kitchen timezone offset from UTC in minutes (330 = India Standard Time)
TZ_OFFSET_MIN=330
